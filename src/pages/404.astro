---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Chris Taylor">
  <main class="mx-auto max-w-2xl px-5 py-12">
    <h1 class="text-2xl font-bold tracking-tight">Page not found</h1>
    <p class="text-muted mt-2 text-sm">
      This page doesn't exist, or it moved when the site was rebuilt.
    </p>
    <p class="mt-4 text-sm">
      <a href="/" class="text-accent hover:underline">Back to the homepage →</a>
    </p>
  </main>
</BaseLayout>
