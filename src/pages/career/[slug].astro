---
// Per-role detail page (same row → detail model as projects). This is where the
// "more" detail lives, keeping the homepage a lean hub (LinkedIn stays the full CV).
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const roles = (await getCollection('career')).filter((r) => !r.data.break);
  return roles.map((r) => ({ params: { slug: r.id }, props: { role: r } }));
}

const { role } = Astro.props;
const { Content } = await render(role);
const { org, role: title, from, to, location, url } = role.data;
---

<BaseLayout
  title={`${title} · ${org} — Chris Taylor`}
  description={`${title} at ${org}, ${from}–${to}.`}
  type="article"
>
  <main class="mx-auto max-w-2xl px-5 py-12">
    <nav class="text-muted text-xs">
      <a href="/" class="hover:text-accent">Chris Taylor</a>
      <span class="mx-1">▸</span>
      <a href="/#career" class="hover:text-accent">Career</a>
      <span class="mx-1">▸</span>
      <span class="text-ink">{org}</span>
    </nav>

    <header class="border-rule mt-3 border-b pb-5">
      <h1 class="text-2xl font-bold tracking-tight">{org}</h1>
      <p class="text-muted mt-1 text-sm">{title}</p>
      <p class="tabular text-muted mt-2 text-xs">
        {from}–{to}{location && ` · ${location}`}
        {
          url && (
            <a href={url} class="text-accent ml-2">
              site →
            </a>
          )
        }
      </p>
    </header>

    <article
      class="[&_a]:text-accent mt-6 max-w-none space-y-3 text-sm leading-relaxed [&_a]:underline [&_a]:underline-offset-2"
    >
      <Content />
    </article>
  </main>
</BaseLayout>
