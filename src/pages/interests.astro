---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const interests = (await getCollection('interests'))
  .filter((i) => !i.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Interests — Chris Taylor"
  description="Maps of transport and cities that Chris Taylor makes outside work."
>
  <main class="mx-auto max-w-5xl px-5 py-12">
    <nav class="text-muted text-xs">
      <a href="/" class="hover:text-accent">Chris Taylor</a>
      <span class="mx-1">▸</span>
      <span class="text-ink">Interests</span>
    </nav>

    <header class="border-rule mt-3 border-b pb-5">
      <h1 class="text-2xl font-bold tracking-tight">Interests</h1>
      <p class="text-muted mt-1 max-w-2xl text-sm">
        I studied geography and GIS before I wrote code, and I never really stopped making maps.
        These are side projects: public data on cities and railways, turned into something you can
        read at a glance.
      </p>
    </header>

    <ul class="mt-6 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        interests.map((i) => (
          <li class="flex flex-col">
            <a href={i.data.url} class="group block" target="_blank" rel="noopener">
              <Image
                src={i.data.image}
                alt={i.data.imageAlt}
                width={1200}
                height={750}
                widths={[400, 640, 960, 1200]}
                sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 50vw, 100vw"
                class="border-rule group-hover:border-accent w-full rounded-xs border"
              />
              <h2 class="text-accent mt-3 text-sm font-medium">
                {i.data.title}
                <span class="text-muted group-hover:text-accent ml-1" aria-hidden="true">
                  ↗
                </span>
              </h2>
            </a>
            <p class="mt-1 text-sm">{i.data.caption}</p>
            <p class="text-muted mt-1 text-xs">Data: {i.data.credit}.</p>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
