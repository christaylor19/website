---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

// PROTOTYPE content. Real CV facts where known; Lorem Ipsum for any prose.
// Projects and career both come from content collections — the same entries the
// /projects/[slug] and /career/[slug] detail pages are generated from.

const facts = [
  ['Role', 'Senior Frontend Engineer'],
  ['Company', 'ClearScore'],
  ['Based', 'London, UK'],
  ['Stack', 'TypeScript · React · Node · server-driven UI'],
  ['Background', 'BSc Geography, Reading · MSc GIS, Edinburgh'],
];

const setup = [
  ['Agent', 'Claude Code'],
  ['Terminal', 'cmux'],
  ['Editor', 'Zed, for reading and reviewing'],
];

const principles = [
  [
    'Setup beats prompts.',
    'A rough prompt in a well-set-up workspace beats a polished one in an empty workspace.',
  ],
  [
    'Every fact has one home.',
    "Rules, memory, notes and repo conventions each live in one place, so they don't drift.",
  ],
  ['Hooks enforce, memory advises.', 'Anything that must always happen is a hook, not a note.'],
  [
    'Check outcomes, not diffs.',
    'CI, smoke tests and the live page tell you more than reading every line.',
  ],
  [
    'Agents work in parallel.',
    'Each one gets its own worktree and its own browser, and proves its work with screenshots.',
  ],
];

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const interests = (await getCollection('interests'))
  .filter((i) => !i.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const career = (await getCollection('career')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Chris Taylor">
  <main class="mx-auto max-w-2xl px-5 py-12">
    <!-- Identity panel (PCS rider info block) -->
    <header class="border-rule border-b pb-6">
      <h1 class="text-2xl font-bold tracking-tight">Chris Taylor</h1>
      <p class="text-muted mt-1 text-sm">
        Frontend engineer in London. I build the web side of ClearScore, from React apps to the
        server-driven services behind them. Outside work it's maps, sport and transport data.
      </p>
      <dl class="mt-4 grid grid-cols-[6rem_1fr] gap-x-3 gap-y-1 text-sm">
        {
          facts.map(([k, v]) => (
            <>
              <dt class="text-muted">{k}</dt>
              <dd class="font-medium">{v}</dd>
            </>
          ))
        }
      </dl>
    </header>

    <!-- Career table (dense rows → detail pages). First, above projects. -->
    <section id="career" class="mt-8">
      <h2 class="text-muted mb-2 text-xs font-semibold tracking-wide uppercase">Career</h2>
      <table class="w-full text-sm">
        <tbody>
          {
            career.map((c) =>
              c.data.break ? (
                <tr class="border-rule text-muted border-b">
                  <td class="py-1.5 pr-3 whitespace-nowrap italic">{c.data.org}</td>
                  <td class="py-1.5">{c.data.role}</td>
                  <td class="tabular py-1.5 pl-2 text-right whitespace-nowrap">
                    {c.data.from}–{c.data.to}
                  </td>
                  <td class="py-1.5 pl-2" />
                </tr>
              ) : (
                <tr class="group border-rule hover:bg-surface border-b">
                  <td class="py-1.5 pr-3 whitespace-nowrap">
                    <a href={`/career/${c.id}`} class="text-accent font-medium">
                      {c.data.org}
                    </a>
                  </td>
                  <td class="text-muted py-1.5">{c.data.role}</td>
                  <td class="tabular text-muted py-1.5 pl-2 text-right whitespace-nowrap">
                    {c.data.from}–{c.data.to}
                  </td>
                  <td class="text-muted group-hover:text-accent py-1.5 pl-2 text-right">→</td>
                </tr>
              ),
            )
          }
        </tbody>
      </table>
    </section>

    <!-- Projects table (dense repeating rows → detail pages) -->
    <section id="projects" class="mt-8">
      <h2 class="text-muted mb-2 text-xs font-semibold tracking-wide uppercase">Projects</h2>
      <table class="w-full text-sm">
        <tbody>
          {
            projects.map((p) => (
              <tr class="group border-rule hover:bg-surface border-b">
                <td class="py-1.5">
                  <a href={`/projects/${p.id}`} class="text-accent font-medium">
                    {p.data.title}
                  </a>
                </td>
                <td class="py-1.5 text-right">
                  {p.data.featured && (
                    <span class="text-good rounded-xs px-1.5 text-xs font-medium">featured</span>
                  )}
                </td>
                <td class="text-muted group-hover:text-accent py-1.5 pl-2 text-right">→</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section id="how-i-work" class="mt-8">
      <h2 class="text-muted mb-2 text-xs font-semibold tracking-wide uppercase">How I work</h2>
      <p class="text-muted text-sm">
        I do most of my work through Claude Code, and use the editor to read and review rather than
        type.
      </p>
      <dl class="mt-3 grid grid-cols-[6rem_1fr] gap-x-3 gap-y-1 text-sm">
        {
          setup.map(([k, v]) => (
            <>
              <dt class="text-muted">{k}</dt>
              <dd class="font-medium">{v}</dd>
            </>
          ))
        }
      </dl>
      <ul class="mt-4 space-y-2 text-sm">
        {
          principles.map(([title, body]) => (
            <li>
              <span class="font-medium">{title}</span> <span class="text-muted">{body}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="interests" class="mt-8">
      <h2 class="text-muted mb-2 text-xs font-semibold tracking-wide uppercase">Interests</h2>
      <p class="text-muted text-sm">
        I'm into sport, maps, data and transport, and I studied geography and GIS before I wrote
        code. These are maps I make for fun: public data on cities and railways, made easy to read
        at a glance.
      </p>
      <ul class="mt-4 grid gap-x-4 gap-y-6 sm:grid-cols-3">
        {
          interests.map((i) => (
            <li class="flex flex-col">
              <a href={i.data.url} class="group block" target="_blank" rel="noopener">
                <Image
                  src={i.data.image}
                  alt={i.data.imageAlt}
                  width={1200}
                  height={750}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 40rem) 13rem, 100vw"
                  class="border-rule group-hover:border-accent w-full rounded-xs border"
                />
                <h3 class="text-accent mt-2 text-sm font-medium">
                  {i.data.title}
                  <span class="text-muted group-hover:text-accent ml-1" aria-hidden="true">
                    ↗
                  </span>
                </h3>
              </a>
              <p class="mt-1 text-xs leading-relaxed">{i.data.caption}</p>
              <p class="text-muted mt-1 text-xs">Data: {i.data.credit}.</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Links -->
    <footer class="border-rule mt-10 flex gap-4 border-t pt-6 text-sm">
      <a href="https://github.com/christaylor19" class="text-accent">GitHub</a>
      <a href="https://www.linkedin.com/in/chris-taylor-b50703a7/" class="text-accent">LinkedIn</a>
      <a href="mailto:christaylor94.dev@gmail.com" class="text-accent">Email</a>
    </footer>
  </main>
</BaseLayout>
